# Racetap environment (copy to application/config/.env or set real env vars).
# Real environment variables always win over this file.

APP_BASE_URL=http://127.0.0.1:8180/

DB_HOSTNAME=127.0.0.1
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=racetap_dev

# --- OCR -------------------------------------------------------------------
# Automatic engine order (no UI picker). RapidOCR is always tried first.
OCR_ENGINE_ORDER=rapidocr,paddleocr,azure,ocrspace,vision,tesseract

# Free, self-hosted RapidOCR service (see ocr_service/README.md).
# Required by default: while it is unreachable the admin shows an error instead
# of silently falling back to a weaker engine.
OCR_SERVICE_URL=http://127.0.0.1:8010

# Keep "rapidocr" to make RapidOCR mandatory. Set empty to allow the fallback
# chain below during development (RapidOCR still gets tried first).
OCR_REQUIRED_ENGINE=rapidocr

# Free, self-hosted PaddleOCR service (see ocr_service_paddle/). Both local
# engines are optional; an unreachable service is skipped automatically.
PADDLEOCR_SERVICE_URL=

# Google Cloud Vision (premium; 1.000 units/month free, then paid).
# console.cloud.google.com -> enable Cloud Vision API -> Credentials -> API key
GOOGLE_VISION_API_KEY=

# Azure AI Vision F0 (5.000 transactions/month free, 20/minute).
AZURE_VISION_KEY=
AZURE_VISION_ENDPOINT=

# OCR.space free key (https://ocr.space/ocrapi/freekey, ~1 MB per image).
OCRSPACE_API_KEY=

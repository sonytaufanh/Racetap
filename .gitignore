# Dependencies
web/node_modules/

# Build output (regenerated by `npm run build` in web/)
assets/app/
# Runtime / generated data
application/cache/*
!application/cache/index.html
application/logs/*
!application/logs/index.html
results/*/data.json
results/*/data.json.bak*
results/*/data_temp.json*
results/*/error_api.log
results/**/*.zip
results/*/index.*.html
# Uploads (user content, not source)
assets/uploads/*
!assets/uploads/.htaccess
# Secrets
application/config/.env
# OS / editor
.DS_Store
Thumbs.db
*.log
error_log
.ftpquota
# OCR service runtime
ocr_service/.venv/
ocr_service/__pycache__/
ocr_service/*.log
ocr_service_paddle/.venv/
ocr_service_paddle/__pycache__/
ocr_service_paddle/*.log
